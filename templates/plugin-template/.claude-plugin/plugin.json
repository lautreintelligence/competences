{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "plugin-template",
  "displayName": "Plugin Template",
  "version": "0.1.0",
  "description": "Gabarit de depart. Renommer, puis supprimer tout composant non utilise.",
  "author": {
    "name": "L'Autre Intelligence & Nous",
    "url": "https://github.com/lautreintelligence"
  },
  "homepage": "https://github.com/lautreintelligence/competences",
  "repository": "https://github.com/lautreintelligence/competences",
  "license": "Apache-2.0",
  "keywords": [
    "template"
  ],
  "defaultEnabled": true,
  "skills": [
    "./skills/"
  ],
  "commands": [
    "./commands/"
  ],
  "agents": [
    "./agents/example-agent.md"
  ],
  "workflows": "./workflows/",
  "outputStyles": "./output-styles/",
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./.mcp.json",
  "lspServers": "./.lsp.json",
  "experimental": {
    "themes": "./themes/",
    "monitors": "./monitors/monitors.json"
  }
